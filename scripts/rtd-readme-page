#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 Mateusz Okulanis <FPGArtktic@outlook.com>
#
# rtd-readme-page - render README.md as the Read the Docs start page
#
# Writes $READTHEDOCS_OUTPUT/html/index.html from README.md and copies the
# docs/ tree, which holds the images the README embeds, next to it. Links to
# other repository files point to GitHub; anchors, absolute URLs and docs/
# links stay as they are. Heading anchors follow GitHub's rules, so that the
# README's own links keep working.
#
# Read the Docs does not run build commands through a regular shell (pipes and
# backslash escapes do not survive), so everything the build needs happens
# here: on Read the Docs (READTHEDOCS=True) a missing Python-Markdown is
# installed first, pinned by version and hash. Elsewhere it must be installed.
#
# Usage: READTHEDOCS_OUTPUT=DIR scripts/rtd-readme-page
"""Render README.md as the Read the Docs start page."""

import importlib
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

REPO = "https://github.com/FPGArtktic/lazysubmodules/blob/main/"

MARKDOWN_PIN = (
    "markdown==3.10.3 "
    "--hash=sha256:fa6c92a00a4a3c98b22728c64a935ae1928250ae65058a6ded814d2cc29a4cea"
)

PAGE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LazySubmodules</title>
<style>
:root {{ color-scheme: light dark; }}
body {{ max-width: 52rem; margin: 2rem auto; padding: 0 1rem;
       font: 16px/1.6 system-ui, sans-serif; }}
img {{ max-width: 100%; }}
pre {{ overflow-x: auto; padding: .75rem; border-radius: 6px;
      background: rgba(127, 127, 127, .12); }}
code {{ font-family: ui-monospace, monospace; }}
table {{ border-collapse: collapse; display: block; overflow-x: auto; }}
th, td {{ border: 1px solid rgba(127, 127, 127, .35); padding: .3rem .6rem; }}
</style>
</head>
<body>
{body}
</body>
</html>
"""


def load_markdown():
    """Return the markdown module, installing the pinned one on Read the Docs."""
    try:
        return importlib.import_module("markdown")
    except ImportError:
        if os.environ.get("READTHEDOCS") != "True":
            sys.exit("rtd-readme-page: Python-Markdown is missing (pip install markdown)")
    with tempfile.TemporaryDirectory() as tmp:
        requirements = pathlib.Path(tmp, "requirements.txt")
        requirements.write_text(MARKDOWN_PIN + "\n", encoding="utf-8")
        subprocess.run(
            [sys.executable, "-m", "pip", "install", "--no-cache-dir",
             "--require-hashes", "--only-binary=:all:", "-r", str(requirements)],
            check=True,
        )
    importlib.invalidate_caches()
    return importlib.import_module("markdown")


def github_slug(value, separator):
    """Return a heading anchor the way GitHub makes it.

    Every space becomes the separator, repeated spaces included, which is
    where GitHub differs from Python-Markdown's default.
    """
    value = re.sub(r"[^\w\- ]", "", value.strip().lower())
    return value.replace(" ", separator)


def repo_link(match):
    """Point a link or image to GitHub unless it works on the page as is."""
    attr, target = match.group(1), match.group(2)
    if re.match(r"([a-z]+:|#|docs/)", target):
        return match.group(0)
    return f'{attr}="{REPO}{target}"'


def main():
    """Render the page and copy the images."""
    markdown = load_markdown()
    html_dir = pathlib.Path(os.environ["READTHEDOCS_OUTPUT"], "html")
    html_dir.mkdir(parents=True, exist_ok=True)
    if pathlib.Path("docs").is_dir():
        shutil.copytree("docs", html_dir / "docs", dirs_exist_ok=True)
    body = markdown.markdown(
        pathlib.Path("README.md").read_text(encoding="utf-8"),
        extensions=["extra", "toc", "sane_lists"],
        extension_configs={"toc": {"slugify": github_slug}},
    )
    body = re.sub(r'(href|src)="([^"]*)"', repo_link, body)
    (html_dir / "index.html").write_text(PAGE.format(body=body), encoding="utf-8")


if __name__ == "__main__":
    main()
