# Build outputs and local test artifacts.

# Private project notes, kept out of the repository on purpose.
project.md

# scripts/build-in-container.sh: build writes bin/, snapshot and release dist/.
/bin/
/dist/

# scripts/build-in-container.sh: coverage writes its report to coverage/.
/coverage/

# scripts/build-in-container.sh: docs writes the built site to docs/_build/
# (html/ and the Sphinx cache in doctrees/).
/docs/_build/

# scripts/third-party-licenses.sh, a GoReleaser before hook, writes the
# license notices for archives and packages to build/third-party/.
/build/

# Binaries of a plain "go build" on the host.
/lazysubmodules
/cmd/lazysubmodules/lazysubmodules
*.test
/coverage.out
